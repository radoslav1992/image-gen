---
import {bindings} from '../lib/server';
const {mode='login'}=Astro.props;const e=bindings();const title={login:'Радваме се да ви видим.',register:'Дайте образ на идеите си.',forgot:'Нека възстановим достъпа.',reset:'Ново начало. Нова парола.'}[mode as 'login'];
---
<section class="auth-section"><div class="auth-story"><span class="eyebrow">ДОБРЕ ДОШЛИ В ОБРАЗ</span><h1>Всяка голяма визия<br/>започва с <em>малка идея.</em></h1><img src="/images/inspiration.png" alt="Демонстрационна AI визия на фантастичен свят"/><p>Вашето място за експерименти, вдъхновение и нови светове.</p></div><div class="auth-card panel"><span class="eyebrow">ВАШЕТО ТВОРЧЕСКО ПРОСТРАНСТВО</span><h2>{title}</h2><form id="auth-form" data-mode={mode}>{mode==='register'&&<><label for="name">Вашето име</label><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="80"/></>}{mode!=='reset'&&<><label for="email">Имейл адрес</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com"/></>}{mode!=='forgot'&&<><label for="password">Парола</label><input id="password" name="password" type="password" autocomplete={mode==='login'?'current-password':'new-password'} required minlength={mode==='login'?1:12} maxlength="128"/>{mode!=='login'&&<small class="muted">Поне 12 символа.</small>}</>}{mode==='register'&&<label class="checkbox terms-check"><input type="checkbox" name="terms" required/> <span>Приемам <a href="/terms" target="_blank">условията</a> и съм запознат/а с <a href="/privacy" target="_blank">политиката за поверителност</a>.</span></label>}{['register','forgot'].includes(mode)&&e.TURNSTILE_SITE_KEY&&<div class="cf-turnstile" data-sitekey={e.TURNSTILE_SITE_KEY} data-theme="dark"></div>}<button class="button full" type="submit">{mode==='login'?'Вход в студиото':mode==='register'?'Създай профил':mode==='forgot'?'Изпрати линк':'Запази паролата'} ↗</button><p class="status" id="auth-status" role="status" aria-live="polite"></p></form><div class="auth-links">{mode==='login'?<><a href="/forgot">Забравена парола?</a><p>Нямате профил? <a href="/register">Регистрирайте се →</a></p></>:<a href="/login">Вече имате профил? Вход →</a>}</div></div></section>
{e.TURNSTILE_SITE_KEY&&<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
 const form=document.querySelector<HTMLFormElement>('#auth-form')!;form.addEventListener('submit',async ev=>{ev.preventDefault();const mode=form.dataset.mode!;const status=document.querySelector<HTMLElement>('#auth-status')!;const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;button.disabled=true;status.textContent='Обработваме заявката…';const data=Object.fromEntries(new FormData(form));try{const r=await fetch(`/api/auth/${mode}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...data,terms:data.terms==='on',turnstile:data['cf-turnstile-response'],token:new URLSearchParams(location.search).get('token')})});const d=await r.json() as Record<string,any>;if(!r.ok)throw new Error(d.error);if(mode==='forgot'){status.textContent=d.message;return;}if(mode==='reset'){location.href='/login';return;}const next=new URLSearchParams(location.search).get('next');location.href=next&&['/studio','/library','/account','/pricing'].includes(next)?next:'/studio';}catch(e){status.textContent=e instanceof Error?e.message:'Възникна проблем.';const widget=(window as any).turnstile;widget?.reset();}finally{button.disabled=false;}});
</script>
