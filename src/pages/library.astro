---
import Layout from '../layouts/Layout.astro';import {userFor,bindings} from '../lib/server';import {MODELS} from '../lib/catalog';
const user=await userFor(Astro);if(!user)return Astro.redirect('/login?next=/library');
const search=(Astro.url.searchParams.get('q')||'').slice(0,100);const favorite=Astro.url.searchParams.get('favorite')==='1';const page=Math.max(1,Math.min(10000,Number(Astro.url.searchParams.get('page'))||1));
const result=await bindings().DB.prepare("SELECT id,prompt,model,style,favorite,created_at FROM images WHERE user_id=? AND status='complete' AND (?=0 OR favorite=1) AND prompt LIKE ? ESCAPE '\\' ORDER BY created_at DESC LIMIT 25 OFFSET ?").bind(user.id,favorite?1:0,`%${search.replace(/[\\%_]/g,'\\$&')}%`,(page-1)*24).all<{id:string;prompt:string;model:keyof typeof MODELS;style:string;favorite:number;created_at:number}>();const rows=result.results.slice(0,24);const next=result.results.length>24;const pageUrl=(p:number)=>`/library?${new URLSearchParams({q:search,favorite:favorite?'1':'0',page:String(p)})}`;
---
<Layout title="Моята библиотека — Образ" app user={user}><section class="workspace"><div class="page-heading"><div><span class="eyebrow">ВАШИТЕ ИДЕИ, НА ЕДНО МЯСТО</span><h1>Моята библиотека<span class="orange">.</span></h1><p>Само вие имате достъп до тези изображения.</p></div><a class="button" href="/studio">+ Ново изображение</a></div><form class="library-filters"><label class="sr-only" for="q">Търсете в описанията</label><input type="search" name="q" id="q" placeholder="Търсете по описание…" value={search}/><label class="checkbox"><input type="checkbox" name="favorite" value="1" checked={favorite}/> Само любими</label><button class="button small dark">Търси →</button></form>{rows.length?<div class="image-grid">{rows.map(row=><article class="image-card" data-id={row.id}><a href={`/api/images/${row.id}`} target="_blank" aria-label="Отвори изображението"><img loading="lazy" src={`/api/images/${row.id}`} alt={row.prompt}/></a><div class="image-info"><small>{MODELS[row.model]?.name} · {new Date(row.created_at*1000).toLocaleDateString('bg-BG')}</small><p>{row.prompt}</p><div class="image-buttons"><button class:list={['icon-button',row.favorite&&'favorite']} data-favorite aria-label="Любимо" aria-pressed={!!row.favorite}>♥</button><a class="icon-button" href={`/api/images/${row.id}?download=1`} aria-label="Изтегли">↓</a><a class="icon-button" href={`/studio?prompt=${encodeURIComponent(row.prompt)}`} aria-label="Използвай описанието">↗</a><button class="icon-button" data-delete aria-label="Изтрий">×</button></div></div></article>)}</div>:<div class="empty-library panel"><span class="preview-icon">◈</span><h2>{search||favorite?'Няма изображения с тези филтри.':'Всяка колекция започва с една идея.'}</h2><p>{search||favorite?'Променете търсенето или покажете всички изображения.':'Създайте първото си изображение. Ще го откриете тук.'}</p><a class="button" href={search||favorite?'/library':'/studio'}>{search||favorite?'Покажи всички':'Към студиото ↗'}</a></div>}<div class="pagination">{page>1&&<a href={pageUrl(page-1)}>← Предишна</a>}<span>Страница {page}</span>{next&&<a href={pageUrl(page+1)}>Следваща →</a>}</div></section><dialog id="delete-dialog"><h2>Да изтрием ли изображението?</h2><p>Изображението ще бъде изтрито окончателно. Използваните кредити не се възстановяват.</p><div class="hero-actions"><button class="button dark" id="delete-cancel">Отказ</button><button class="button" id="delete-confirm">Изтрий</button></div><p id="delete-error" role="alert"></p></dialog>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('#delete-dialog')!;let selected:HTMLElement|null=null;const toast=document.querySelector<HTMLElement>('#toast')!;function message(t:string){toast.textContent=t;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),4000);}
 document.querySelectorAll<HTMLElement>('.image-card').forEach(card=>{card.querySelector('[data-favorite]')?.addEventListener('click',async e=>{const b=e.currentTarget as HTMLButtonElement;b.disabled=true;try{const r=await fetch(`/api/images/${card.dataset.id}`,{method:'PATCH'});const d=await r.json() as Record<string,any>;if(!r.ok)throw new Error(d.error);b.classList.toggle('favorite',!!d.favorite);b.setAttribute('aria-pressed',String(!!d.favorite));}catch(e){message(e instanceof Error?e.message:'Възникна проблем.');}finally{b.disabled=false;}});card.querySelector('[data-delete]')?.addEventListener('click',()=>{selected=card;dialog.showModal();});});
 document.querySelector('#delete-cancel')!.addEventListener('click',()=>dialog.close());document.querySelector('#delete-confirm')!.addEventListener('click',async()=>{if(!selected)return;const b=document.querySelector<HTMLButtonElement>('#delete-confirm')!;b.disabled=true;try{const r=await fetch(`/api/images/${selected.dataset.id}`,{method:'DELETE'});const d=await r.json() as Record<string,any>;if(!r.ok)throw new Error(d.error);location.reload();}catch(e){document.querySelector('#delete-error')!.textContent=e instanceof Error?e.message:'Възникна проблем.';b.disabled=false;}});
</script></Layout>
