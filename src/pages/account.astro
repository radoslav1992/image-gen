---
import Layout from '../layouts/Layout.astro';import {userFor,bindings} from '../lib/server';import {PLANS} from '../lib/catalog';
const user=await userFor(Astro);if(!user)return Astro.redirect('/login?next=/account');const plan=PLANS[user.plan as keyof typeof PLANS];const percent=Math.min(100,user.storage_used/user.storage_limit*100);
---
<Layout title="Моят профил — Образ" app user={user}><section class="workspace account"><div class="page-heading"><div><span class="eyebrow">ВАШЕТО ПРОСТРАНСТВО</span><h1>Здравейте, {user.name}<span class="orange">.</span></h1><p>{user.email}</p></div><button data-logout class="button small dark">Изход →</button></div>{Astro.url.searchParams.get('payment')==='success'&&<p class="notice">Благодарим ви! Кредитите се активират след потвърждение на плащането. Ако още не ги виждате, обновете страницата след няколко секунди.</p>}<div class="account-grid"><article class="panel"><span class="eyebrow">ВАШИЯТ ПЛАН</span><h2>{plan?.name||'Без активен абонамент'}</h2><p>{user.period_end?`Платен период до ${new Date(user.period_end*1000).toLocaleDateString('bg-BG')}`:'Изберете план, за да започнете да създавате.'}</p>{user.stripe_customer?<button class="button" id="portal">Управление на абонамента ↗</button>:<a href="/pricing" class="button">Виж плановете ↗</a>}<p id="portal-status" role="status"></p></article><article class="panel"><span class="eyebrow">ГОТОВИ ЗА НОВИ ИДЕИ</span><div class="big-number">{user.credits.toLocaleString('bg-BG')}</div><p>налични кредита</p><a class="text-link" href="/studio">Отвори студиото →</a></article><article class="panel"><span class="eyebrow">ЛИЧНА БИБЛИОТЕКА</span><h2>{(user.storage_used/1e9).toFixed(3)} / {user.storage_limit/1e9} GB</h2><progress value={percent} max="100" aria-label="Използвано място"></progress><p>Запазените изображения остават достъпни за изтегляне и след прекратяване на абонамента.</p><a href="/library" class="text-link">Управлявай библиотеката →</a></article></div><p class="muted">За нова парола използвайте <a href="/forgot">възстановяване на достъпа</a>.</p>{bindings().CONTACT_EMAIL&&<p class="muted">За въпроси и изтриване на профил: <a href={`mailto:${bindings().CONTACT_EMAIL}`}>{bindings().CONTACT_EMAIL}</a></p>}</section>
<script>
 document.querySelector<HTMLButtonElement>('#portal')?.addEventListener('click',async e=>{const button=e.currentTarget as HTMLButtonElement;button.disabled=true;try{const r=await fetch('/api/billing/portal',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});const d=await r.json() as Record<string,any>;if(!r.ok)throw new Error(d.error);location.href=d.url;}catch(e){document.querySelector('#portal-status')!.textContent=e instanceof Error?e.message:'Възникна проблем.';button.disabled=false;}});
</script></Layout>
