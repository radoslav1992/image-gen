---
import Layout from '../layouts/Layout.astro';import {userFor,bindings} from '../lib/server';import {MODELS} from '../lib/catalog';
const gatewayReady=Boolean(bindings().AI_GATEWAY_ID);const user=await userFor(Astro);if(!user)return Astro.redirect('/login?next=/studio');
---
<Layout title="Студио — Образ" app user={user}><section class="workspace"><div class="page-heading"><div><span class="eyebrow">ОТ ИДЕЯ ДО ОБРАЗ</span><h1>Вашето творческо студио<span class="orange">.</span></h1><p>Опишете нещо, което още не съществува.</p></div><a href="/library" class="button small dark">Моята библиотека ↗</a></div><div class="studio-grid"><form id="generate-form" class="panel controls"><div class="panel-title"><span>✦</span><h2>Създайте изображение</h2></div><label for="prompt">Какво си представяте?</label><textarea id="prompt" name="prompt" rows="6" maxlength="1500" minlength="3" required placeholder="Малка къща в Родопите, утринна мъгла, топла светлина през прозорците, кинематографична фотография..."></textarea><div class="field-note"><span>Детайлите правят разликата.</span><span id="char-count">0 / 1500</span></div><label for="model">Изберете модел</label><select name="model" id="model">{Object.entries(MODELS).map(([key,m])=><option value={key} selected={key==='klein'} disabled={m.thirdParty&&!gatewayReady} data-credits={m.credits} data-format={m.format}>{m.name} · {m.credits} {m.credits===1?'кредит':'кредита'}{m.thirdParty&&!gatewayReady?' · очаква активиране':''}</option>)}</select><label for="style">Визуален стил</label><select name="style" id="style"><option value="none">Без допълнителен стил</option><option value="photo">Фотография</option><option value="cinema">Кинематографичен</option><option value="illustration">Илюстрация</option><option value="render">3D визуализация</option><option value="anime">Аниме</option></select><div class="format-note"><span id="model-format">◻ 1024 × 1024</span><span>Едно изображение</span></div><button class="button full" id="generate-button" type="submit">Създай изображение <span id="cost">2 кредита ✦</span></button><p id="generation-status" class="status" role="status" aria-live="polite"></p><p class="muted tiny">Неуспешните заявки не изразходват кредити. Изображенията се запазват автоматично.</p></form><div class="preview panel" id="preview"><div id="preview-empty" class="preview-empty"><span class="preview-icon">✳</span><h2>Тук започва вашият следващ образ.</h2><p>Напишете идея и оставете въображението да работи.</p><div class="suggestions"><button data-prompt="Минималистична продуктова фотография на парфюм върху тъмен камък, оранжева светлина, премиум реклама">Продуктова визия ↗</button><button data-prompt="Малка къща в Родопите, утринна мъгла, топла светлина през прозорците, кинематографична фотография">Пейзаж от Родопите ↗</button><button data-prompt="Футуристичен град над облаците, залез, летящи градини, детайлна фантастична илюстрация">Нов свят ↗</button></div></div><img id="result-image" hidden alt="Вашето генерирано изображение"/><div class="result-actions" hidden id="result-actions"><span>Готово. Идеята вече има образ.</span><a id="download" class="button small light">Изтегли ↓</a><a href="/library" class="button small dark">Библиотека ↗</a></div></div></div></section>
<script>
 const form=document.querySelector<HTMLFormElement>('#generate-form')!;const prompt=document.querySelector<HTMLTextAreaElement>('#prompt')!;const status=document.querySelector<HTMLElement>('#generation-status')!;const button=document.querySelector<HTMLButtonElement>('#generate-button')!;let pending=false;let requestKey='';
 document.querySelector('#model')!.addEventListener('change',(e)=>{const option=(e.target as HTMLSelectElement).selectedOptions[0];const n=Number(option.dataset.credits);document.querySelector('#cost')!.textContent=`${n} ${n===1?'кредит':'кредита'} ✦`;document.querySelector('#model-format')!.textContent=`◻ ${option.dataset.format}`;});
 prompt.addEventListener('input',()=>document.querySelector('#char-count')!.textContent=`${prompt.value.length} / 1500`);
 const params=new URLSearchParams(location.search);if(params.get('prompt')){prompt.value=params.get('prompt')!.slice(0,1500);prompt.dispatchEvent(new Event('input'));}
 document.querySelectorAll<HTMLButtonElement>('[data-prompt]').forEach(b=>b.addEventListener('click',()=>{prompt.value=b.dataset.prompt!;prompt.dispatchEvent(new Event('input'));prompt.focus();}));
 form.addEventListener('submit',async ev=>{ev.preventDefault();if(pending)return;pending=true;button.disabled=true;status.textContent='Създаваме вашето изображение. Останете на страницата…';document.querySelector('#preview')!.classList.add('generating');const data=Object.fromEntries(new FormData(form));requestKey=requestKey||crypto.randomUUID();
 try{const r=await fetch('/api/generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...data,requestKey})});const d=await r.json() as Record<string,any>;if(!r.ok){requestKey='';throw new Error(d.error);}if(d.status==='pending'){status.textContent='Заявката още се обработва. Проверете библиотеката след малко.';return;}if(d.status==='failed'){requestKey='';throw new Error('Предишната заявка е неуспешна. Опитайте отново.');}document.querySelector<HTMLElement>('#preview-empty')!.hidden=true;const img=document.querySelector<HTMLImageElement>('#result-image')!;img.src=`/api/images/${d.id}`;img.hidden=false;document.querySelector<HTMLElement>('#result-actions')!.hidden=false;document.querySelector<HTMLAnchorElement>('#download')!.href=`/api/images/${d.id}?download=1`;status.textContent='Изображението е запазено в библиотеката.';requestKey='';const balance=await fetch('/api/me').then(r=>r.json()) as {credits:number};const top=document.querySelector('.header-end .button');if(top&&balance.credits!==undefined)top.firstChild!.textContent=`${balance.credits.toLocaleString('bg-BG')} кредита `;}
 catch(e){status.textContent=e instanceof Error?e.message:'Връзката прекъсна. Проверете библиотеката или опитайте същата заявка отново.';}finally{pending=false;button.disabled=false;document.querySelector('#preview')!.classList.remove('generating');}});
</script></Layout>
